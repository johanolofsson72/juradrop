-- allium: 3

-- Spec 045: Postnummer anonymisering — deterministic postcode scrub + address anchor.
-- Elicited 2026-06-08 from specs/045-postnummer-anonymisering/spec.md (post-clarify).
-- Field provenance: tester Meja asked whether anonymisering also covers
-- addresses and postnummer. Investigation: street addresses are model-only
-- with no net; postnummer are covered NOWHERE. This extends the spec-039
-- scrub + the spec-014 sweep with a fourth category (Postnr) and uses a
-- surviving postnummer as an address-line anchor in the warning.

-- The spec-039 categories plus the new postnummer category. One shared
-- pattern source per category (RE_* in pii_sweep), consumed by both the
-- scrub (replace) and the sweep (warn).
enum PiiCategory { personnummer | telefon | epost | postnummer }

external entity Zone {
    id: String
}

external entity ExtractedDocument {
    text: String
}

-- One deterministic replacement performed by the scrub. (Spec 039 entity,
-- now reachable with category = postnummer.)
entity Replacement {
    registry: PlaceholderRegistry
    category: PiiCategory
    matched_value: String      -- in-memory only, never persisted/logged
    index: Integer             -- 1-based, per category, first-occurrence order
    placeholder: String        -- "[Postnr N]" for the new category

    invariant BracketedFormat {
        -- "[Postnr N]" is added to the sweep's placeholder mask (FR-007), so a
        -- postnummer placeholder can never count as residue
        this.is_bracketed_sweep_maskable = true
    }
}

-- The in-memory value -> (category, index) map for ONE Anonymisera run.
entity PlaceholderRegistry {
    document: ExtractedDocument
    replacements: Replacement with registry = this

    invariant SameValueSameIndex {
        for r in replacements:
            not exists other in replacements
                where other.matched_value = r.matched_value
                and other.category = r.category
                and other.index != r.index
    }
    invariant SequentialFirstOccurrence {
        this.indices_dense_per_category = true
    }
    invariant NeverPersisted {
        -- Principle I: the registry (incl. postnummer values) lives only for the run
        this.persisted = false
        this.logged = false
    }
}

entity ScrubResult {
    registry: PlaceholderRegistry
    scrubbed_text: String
    count_personnummer: Integer
    count_telefon: Integer
    count_epost: Integer
    count_postnummer: Integer

    invariant NoCanonicalPostnummerResidue {
        -- SC-001: zero canonical spaced postnummer remain in the scrubbed output
        this.scrubbed_text_matches_postnummer_pattern = false
    }
    invariant NonPostnummerTokensByteIdentical {
        -- SC-002/FR-004: amounts (NN NNN), case numbers (T 4521-25), dates,
        -- unspaced 5-digit runs, leading-0 spaced forms and double/tab forms
        -- are left byte-identical — only the canonical NNN NN grouping moves
        this.non_postnummer_tokens_unchanged = true
    }
    invariant Utf8Safe {
        -- FR-011: replacement never corrupts adjacent Swedish characters
        this.scrubbed_text_valid_utf8 = true
    }
}

-- The output-side residue findings (spec-014 PiiFindings, extended with a
-- postnummer count and the address-anchor framing).
entity SweepFindings {
    output_text: String
    residual_personnummer: Integer
    residual_telefon: Integer
    residual_epost: Integer
    residual_postnummer: Integer

    is_clean: residual_personnummer + residual_telefon + residual_epost + residual_postnummer = 0

    invariant AddressAnchorWhenPostnummerResidue {
        -- FR-008: when any postnummer survives into the output, the warning
        -- reports it AND frames it as a likely-leaked address line to re-check
        this.residual_postnummer > 0 implies this.warning_frames_postnummer_as_address
    }
    invariant CleanMeansNoWarning {
        -- placeholders never count: a run with only [Postnr N] is clean
        this.is_clean implies this.warning_absent
    }
}

-- ── Rules ────────────────────────────────────────────────────────────────

rule ScrubPostnummerBeforeChunking {
    when: AnonymiseraDispatch(document)
    ensures:
        -- FR-001/FR-003: the canonical spaced postnummer in the WHOLE extracted
        -- text are replaced with [Postnr N] BEFORE the chunk plan is built, so
        -- indices are globally consistent across chunks (alongside the spec-039
        -- personnummer/telefon/epost categories)
        let registry = PlaceholderRegistry.created(document: document)
        let result = ScrubResult.created(registry: registry)
        ChunkPlanBuiltFrom(result)
}

rule PostnummerScrubPrecise {
    when: PostnummerScrub(text)
    ensures:
        -- FR-001/FR-004: only \b[1-9]\d{2}<space|nbsp>\d{2}\b matches; first
        -- digit 1-9 (real postnummer never start with 0, and the 0-band is
        -- reserved to the phone pattern so the two never fight over a span)
        OnlyCanonicalSpacedFormReplaced()
        UnspacedAndAmountAndCaseNumberPreserved()
}

rule OtherZonesUntouched {
    when: NonAnonymiseraDispatch(document, zone)
    requires: zone.id != `anonymisera`
    ensures:
        -- FR-009/SC-005: byte-identical input for every other zone (no postnummer scrub)
        ChunkPlanBuiltFrom(document)
}

rule PromptPreservesPostnummerPlaceholder {
    when: AnonymiseraModelPass(chunk)
    ensures:
        -- FR-006: the system prompt's preserve-verbatim list now names [Postnr N]
        -- alongside [Personnr N] / [Telefon N] / [E-post N]
        PromptListsPostnummerPlaceholder()
}

rule SweepCountsPostnummerAndAnchorsAddress {
    when: AnonymiseraCombinedOutputReady(output)
    ensures:
        -- FR-005/FR-008/SC-004: the sweep (same RE_POSTNUMMER source) counts
        -- residual postnummer; when found, the Swedish warning reports them and
        -- frames them as a possible leaked address line
        let findings = SweepFindings.created(output_text: output)
        if findings.residual_postnummer > 0:
            WarningFramesPostnummerAsAddress(findings)
}

-- ── Global invariants ────────────────────────────────────────────────────

invariant DetectAndReplaceAgreeOnPostnummer {
    -- FR-005: the scrub and the sweep use literally the same RE_POSTNUMMER, so
    -- "replaced" and "warned about" can never disagree on what a postnummer is
    for result in ScrubResults:
        result.postnummer_pattern_is_single_source = true
}

invariant AnonymiseraOnly {
    for registry in PlaceholderRegistries:
        registry.zone_id = `anonymisera`
}

invariant ScrubbedOutputCleanPerSweep {
    -- the canonical-form scrub output contains no postnummer the sweep can find
    -- (detect-and-replace agrees with detect-and-warn by construction)
    for result in ScrubResults:
        result.scrubbed_text_postnummer_residue = 0
}

-- ── Out of scope / accepted limitations ──────────────────────────────────

deferred Replacement.unspaced_postnummer
-- Location hint: pii_scrub/pii_sweep. Bare unspaced 5-digit runs (11435) are
-- deliberately NOT scrubbed — indistinguishable from amounts/reference numbers;
-- left to the model + the static disclaimer (same stance the spec-014 design
-- note takes for free-text street addresses).

deferred SweepFindings.street_address_regex
-- Location hint: pii_sweep design note. Free-text Swedish street addresses have
-- no reliable pattern; the surviving-postnummer anchor is the honest partial
-- signal for the address category, not a full address detector.
