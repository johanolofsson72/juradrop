{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "JuraDrop",
  "version": "0.1.0",
  "identifier": "se.noisycricket.juradrop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JuraDrop",
        "width": 1160,
        "height": 760,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ollama"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "providerShortName": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/johanolofsson72/juradrop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzNTQ2NTQ0MzcwNTNCNkYKUldSdk93VTNSR1ZVSTRpRVlTVG9pb1ZVR2o3NnNVUmRMcm5VNTB0NG9tbnozMHRXZVMvMVdObnQK"
    }
  }
}
